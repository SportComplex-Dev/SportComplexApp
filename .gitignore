# Exportaciones XML de Jira (SCRUM-*.xml): se generan al leer la incidencia.
SCRUM-*.xml

# Credenciales locales generadas por scripts de migración (NO versionar)
.auth-passwords.local.txt

# Backups locales de producción (TSK-BD-01): dumps, artefactos GPG y snapshots
# de identidades de Supabase Auth. Solo viven en el bucket privado `backups`.
backups/
*.gpg
*auth_users_snapshot*.json

# Reportes de auditoría de purga (TSK-BD-02): IDs de registros eliminados.
# Contienen PII/UUIDs de producción; custodiar localmente o fuera de git.
packages/db/purge-reports/

# Git Worktrees locales
.worktrees/

# Agentes locales (Antigravity/Orca) — pero SÍ versionar la suite de skills
.agents/*
!.agents/skills/
!.agents/skills/**
AGENTS.md

# Reportes locales de revisión
CODE_REVIEW_*.md

# Datos locales de contenedores Docker
docker/data/
docker/dev_data/

# Salida generada de Typedoc (artefacto de build, vive en CI artifacts)
docs/api/*
!docs/api/openapi.json
