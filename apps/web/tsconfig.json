{
  "extends": "../../packages/config/typescript/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@db-test/*": ["../../packages/db/test/*"],
      "@sportcomplex/validation": ["../../packages/validation/dist"],
      "@sportcomplex/validation/src/*": ["../../packages/validation/dist/*"],
      "@sportcomplex/validation/*": ["../../packages/validation/dist/*"],
      "@sportcomplex/db": ["../../packages/db/dist"],
      "@sportcomplex/db/src/*": ["../../packages/db/dist/*"],
      "@sportcomplex/db/*": ["../../packages/db/dist/*"],
      "@sportcomplex/core": ["../../packages/core/dist"],
      "@sportcomplex/core/src/*": ["../../packages/core/dist/*"],
      "@sportcomplex/core/*": ["../../packages/core/dist/*"],
      "@sportcomplex/ui": ["../../packages/ui/dist"],
      "@sportcomplex/ui/src/*": ["../../packages/ui/dist/*"],
      "@sportcomplex/ui/*": ["../../packages/ui/dist/*"],
      "@sportcomplex/domain": ["../../packages/domain/dist"],
      "@sportcomplex/domain/*": ["../../packages/domain/dist/*"],
      "@sportcomplex/security": ["../../packages/security/dist"],
      "@sportcomplex/security/*": ["../../packages/security/dist/*"],
      "@sportcomplex/features-booking": ["../../packages/features/booking/dist"],
      "@sportcomplex/features-booking/*": ["../../packages/features/booking/dist/*"]
    },
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitReturns": false,
    "noUnusedParameters": false,
    "noUnusedLocals": false
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
