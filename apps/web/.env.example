# PLANTILLA — copiar a .env.local y llenar con valores de desarrollo.
# Nunca poner valores reales de producción aquí (se commitea).


# --- Supabase / DB ---
# Conexión a Postgres y Auth. DATABASE_URL (pooler, app) y DIRECT_URL (directa, migraciones). Las NEXT_PUBLIC_* se hornean en el build: en prod manda el secret, en dev este valor. SUPABASE_SERVICE_ROLE_KEY es solo-servidor (bypass RLS, jamás exponer).
# TODO(dev-db): DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sportcomplex_dev"
# TODO(dev-db): DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sportcomplex_dev"
NEXT_PUBLIC_SUPABASE_URL="https://xyz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon-key"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"


# --- Auth / QR ---
# QR_HMAC_SECRET firma los QR de tickets. NEXT_PUBLIC_APP_URL es la URL pública (dev: localhost:3000).
QR_HMAC_SECRET="change-me-64-hex"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# --- Membrete del comprobante en PDF ---
# Datos públicos del negocio para el comprobante. Sin secretos.
RECEIPT_ENTIDAD="SportComplex — Complejo Deportivo"
RECEIPT_NIT=""
RECEIPT_DIRECCION=""
RECEIPT_TELEFONO=""
RECEIPT_CORREO=""
RECEIPT_PIE=""


# --- Stripe sandbox ---
# Pagos cashless de prueba (claves test, nunca live aquí). La secret cobra (solo servidor), la publishable es pública.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."


# --- Integraciones ---
# Nager.Date (festivos Colombia, API pública), webhooks y HMAC hacia n8n local, API key del chatbot y zona horaria del negocio (UTC-5 sin DST).
NAGER_DATE_BASE_URL="https://date.nager.at/api/v3"
N8N_CONTINGENCY_WEBHOOK_URL="https://n8n.example.com/webhook/contingency"
N8N_CONTINGENCY_HMAC_SECRET="replace-with-a-random-secret-of-at-least-32-chars"
N8N_AUTH_EMAIL_WEBHOOK_URL="https://n8n.example.com/webhook/auth-email"
BOT_API_KEY="replace-with-a-random-secret-of-at-least-32-chars"
TZ="America/Bogota"


# --- Cron ---
# Expira reservas PENDIENTE_PAGO (TTL 15 min, corre cada minuto). CRON_SECRET protege /api/cron/*; EXPIRE_BATCH_SIZE es el lote por pasada.
CRON_SECRET="change-me-cron-secret"
EXPIRE_BATCH_SIZE="500"


# --- Key interna web<->n8n ---
# Autentica POST /api/internal/* (la web la verifica, n8n la envía por header). Fail-closed 503 si falta. Mínimo 32 chars.
INTERNAL_API_KEY="replace-with-a-random-secret-of-at-least-32-chars"


# --- Auth / Google ---
# OAuth del proyecto dev y secreto de sesión Auth.js (solo servidor).
AUTH_SECRET="replace-with-a-random-secret"
AUTH_GOOGLE_ID="TU_CLIENT_ID"
AUTH_GOOGLE_SECRET="TU_CLIENT_SECRET"


# --- Fallback de autenticación local ---
# Solo mientras haya cuentas con password_hash sin identidad Supabase. "true" en dev, "false" en prod.
AUTH_ALLOW_LOCAL_FALLBACK="false"
