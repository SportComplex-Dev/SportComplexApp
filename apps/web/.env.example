# PLANTILLA — copiar a .env.local y llenar con valores de desarrollo.
# Nunca poner valores reales de producción aquí (se commitea).

# --- Supabase / DB — conexión a Postgres y Auth (dev: proyecto Supabase de desarrollo) ---
# TODO(dev-db): DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sportcomplex_dev"
# TODO(dev-db): DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sportcomplex_dev"
# NEXT_PUBLIC_SUPABASE_URL: Pública y horneada en el build: en prod manda el secret, en dev este valor
NEXT_PUBLIC_SUPABASE_URL="https://xyz.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY: Clave pública (anon); la service_role NUNCA sale del servidor
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon-key"
# SUPABASE_SERVICE_ROLE_KEY: SOLO servidor: bypass RLS. Jamás exponer ni commitear
SUPABASE_SERVICE_ROLE_KEY="service-role-key"

# --- Auth / QR — sesión local y firma de comprobantes ---
# QR_HMAC_SECRET: Firma HMAC de los QR de tickets (64 hex)
QR_HMAC_SECRET="change-me-64-hex"
# NEXT_PUBLIC_APP_URL: URL pública de la app (dev: localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Membrete del comprobante en PDF (TSK-BE-19) — datos públicos del negocio, sin secretos ---
RECEIPT_ENTIDAD="SportComplex — Complejo Deportivo"
RECEIPT_NIT=""
RECEIPT_DIRECCION=""
RECEIPT_TELEFONO=""
RECEIPT_CORREO=""
RECEIPT_PIE=""

# --- Stripe sandbox — pagos cashless de prueba (claves sk_test/pk_test, nunca live aquí) ---
# STRIPE_SECRET_KEY: Solo servidor (cobra). Test aquí; live solo en secret de prod
STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET: Verifica firmas de webhooks Stripe (whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: Pública (pk_test aquí)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Integraciones — n8n local, chatbot y zona horaria ---
# NAGER_DATE_BASE_URL: API pública de festivos de Colombia
NAGER_DATE_BASE_URL="https://date.nager.at/api/v3"
# N8N_CONTINGENCY_WEBHOOK_URL: Webhook de contingencia en n8n local
N8N_CONTINGENCY_WEBHOOK_URL="https://n8n.example.com/webhook/contingency"
# N8N_CONTINGENCY_HMAC_SECRET: Firma HMAC de alertas hacia n8n (mín. 32 chars)
N8N_CONTINGENCY_HMAC_SECRET="replace-with-a-random-secret-of-at-least-32-chars"
# N8N_AUTH_EMAIL_WEBHOOK_URL: Webhook de correo auth en n8n local
N8N_AUTH_EMAIL_WEBHOOK_URL="https://n8n.example.com/webhook/auth-email"
# BOT_API_KEY: API key del chatbot interno
BOT_API_KEY="replace-with-a-random-secret-of-at-least-32-chars"
# TZ: Zona horaria de negocio (America/Bogota, UTC-5 sin DST)
TZ="America/Bogota"

# --- Cron TSK-BD-08 — expira reservas PENDIENTE_PAGO (TTL 15 min, corre cada minuto) ---
# CRON_SECRET: Protege /api/cron/* (Bearer o x-cron-secret)
CRON_SECRET="change-me-cron-secret"
# EXPIRE_BATCH_SIZE: Lote por pasada del job de expiración
EXPIRE_BATCH_SIZE="500"

# --- Key interna web<->n8n — autentica POST /api/internal/* (fail-closed 503 si falta) ---
# INTERNAL_API_KEY: La web la verifica, n8n la envía (header x-internal-key). Mín. 32 chars
INTERNAL_API_KEY="replace-with-a-random-secret-of-at-least-32-chars"

# --- Auth / Google — OAuth dev y secreto de sesión ---
# AUTH_SECRET: Firma cookies/sesiones Auth.js
AUTH_SECRET="replace-with-a-random-secret"
# AUTH_GOOGLE_ID: Client ID OAuth del proyecto Google dev
AUTH_GOOGLE_ID="TU_CLIENT_ID"
# AUTH_GOOGLE_SECRET: Client secret OAuth (solo servidor)
AUTH_GOOGLE_SECRET="TU_CLIENT_SECRET"

# --- Fallback de autenticación local — solo mientras haya cuentas con password_hash sin identidad Supabase ---
# AUTH_ALLOW_LOCAL_FALLBACK: "true" en dev (cuentas seed); "false" en prod
AUTH_ALLOW_LOCAL_FALLBACK="false"
