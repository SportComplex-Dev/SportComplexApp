{
  "name": "@sportcomplex/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --declaration --outDir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@sportcomplex/db": "workspace:*",
    "@sportcomplex/domain": "workspace:*",
    "@sportcomplex/security": "workspace:*",
    "@sportcomplex/seed": "workspace:*",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "ky": "1.7.5",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sportcomplex/config": "workspace:*",
    "@types/node": "22.13.10",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}
