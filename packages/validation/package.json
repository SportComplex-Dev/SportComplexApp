    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sportcomplex/config": "workspace:*",
    "@types/node": "22.13.10",
    "typescript": "5.7.3"
  }
}