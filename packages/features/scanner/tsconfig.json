{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "noEmit": false,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "paths": {
      "@sportcomplex/core": ["../../core/dist"],
      "@sportcomplex/core/*": ["../../core/dist/*"],
      "@sportcomplex/ui": ["../../ui/dist"],
      "@sportcomplex/ui/*": ["../../ui/dist/*"],
      "@sportcomplex/domain": ["../../domain/dist"],
      "@sportcomplex/domain/*": ["../../domain/dist/*"],
      "@sportcomplex/validation": ["../../validation/dist"],
      "@sportcomplex/validation/*": ["../../validation/dist/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__/**"]
}
