{
  "name": "@sportcomplex/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "bootstrap:prod": "tsx prisma/bootstrap-prod.ts",
    "purge:test-users": "tsx scripts/purge-test-users.mts",
    "build": "tsc --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "db:expire": "tsx src/jobs/expire.ts",
    "smoke:be09": "tsx scripts/smoke-be09.mts",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@sportcomplex/config": "workspace:*",
    "@types/node": "22.13.10",
    "dotenv": "^18.0.5",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}
