{
  "openapi": "3.1.0",
  "info": {
    "title": "SportComplex API",
    "version": "1.0.0",
    "description": "API REST interna de apps/web (App Router). Auth perimetral via proxy.ts (RBAC por rol); los handlers consumen @sportcomplex/db y @sportcomplex/core."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Desarrollo"
    }
  ],
  "tags": [
    {
      "name": "Public",
      "description": "Catálogo público, torneos"
    },
    {
      "name": "Auth",
      "description": "Registro, login, verificación, OAuth"
    },
    {
      "name": "Bookings",
      "description": "Reservas, bloqueos, pagos Stripe"
    },
    {
      "name": "Portal",
      "description": "Área cliente: membresías, PDF"
    },
    {
      "name": "Admin",
      "description": "Consola: catálogo, torneos, empleados, analytics"
    },
    {
      "name": "POS",
      "description": "Taquilla cashless"
    },
    {
      "name": "Scanner",
      "description": "Validación de acceso y canje QR"
    },
    {
      "name": "Webhooks",
      "description": "Stripe, n8n, cron, internos"
    },
    {
      "name": "Bot",
      "description": "API v1 para chatbot (n8n)"
    }
  ],
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sc-session"
      },
      "SupabaseBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "BookingRequest": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "CartCheckoutRequest": {
        "description": "Carrito compatible con el formato multi-servicio existente o con franjas consecutivas de un mismo servicio.",
        "oneOf": [
          {
            "type": "object",
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "serviceId",
                    "startTime",
                    "endTime"
                  ],
                  "properties": {
                    "serviceId": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "startTime": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "endTime": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "cantidadCupos": {
                      "type": "integer",
                      "minimum": 1,
                      "default": 1
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "serviceId",
              "franjas"
            ],
            "properties": {
              "serviceId": {
                "type": "integer",
                "minimum": 1
              },
              "franjas": {
                "type": "array",
                "minItems": 2,
                "description": "Debe estar ordenado y cada franja debe iniciar cuando termina la anterior.",
                "items": {
                  "type": "object",
                  "required": [
                    "inicio",
                    "fin"
                  ],
                  "properties": {
                    "inicio": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "fin": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "AvailabilityQuery": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "PosCheckoutRequest": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "PosPaymentIntentRequest": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "RegisterTournamentInput": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "CreateTournamentInput": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "UpdateTournamentInput": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "LoginInput": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "RegisterInput": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "ForgotPasswordInput": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "additionalProperties": false
      },
      "ResetPasswordInput": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "additionalProperties": false
      },
      "CreateEmployeeInput": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "CreateServicioInput": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "UpdateServicioInput": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "CreateCategoriaInput": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "UpdateCategoriaInput": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "AccessScan": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "AccessRedeem": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "BotTicketQuery": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "AnalyticsQueryInput": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "AdminBookingsQuery": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "AdminBookingCancelInput": {
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  },
