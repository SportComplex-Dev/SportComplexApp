# ARCHITECTURE §7.3 — Caddy edge SSL auto (Let's Encrypt)
# VPS compartido: este Caddy es el único proxy en 80/443 para todos los proyectos.
{
  email official@akros.lat
}

# App principal (SportComplex)
# OJO VPS compartido: usar el NOMBRE DE CONTENEDOR (único), nunca el alias
# de servicio `web` — el equipo otium tiene otro servicio `web` en la red
# edge-shared y Docker DNS lo resuelve de forma ambigua (incidente: akros.lat
# sirvió la app de otium).
akros.lat, www.akros.lat {
  reverse_proxy sportcomplex-prod-web-1:3000
}

# n8n (workflows internos) — mismo motivo: nombre de contenedor único.
n8n.akros.lat {
  reverse_proxy sportcomplex-prod-n8n-1:5678
}

# Otro equipo (su DNS lo gestionan ellos; requiere red edge-shared)
# OJO: puerto del CONTENEDOR (3000), no el publicado en el host (3002:3000)
otium.coderhivex.com {
  reverse_proxy jorge-web:3000
}
